# -----------------------------
# Backend (Python/FastAPI) Ignore Rules
# -----------------------------

# Bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Virtual environments
venv/
.venv/
env/
myenv/

# Environment and secrets
.env
.env.*
!.env.example

# Coverage / test artifacts
.coverage
coverage.xml
htmlcov/

# Runtime/temp
logs/
uploads/
tmp/
temp/
*.log
*.sqlite3

# Build/dist
build/
dist/

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/

# Large local RAG artifacts
rag_store/*
!rag_store/.gitkeep

# Large local datasets
data/

# Generated evaluation artifacts
evaluation/results/*
!evaluation/results/.gitkeep
rag_store_backup_*/
